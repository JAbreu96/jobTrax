{
  "mcpServers": {
    "job_tracker": {
      "command": "python3",
      "args": [
        "mcp_servers/job_tracker/server.py"
      ]
    },
    "gmail_personal": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"]
    },
    "gmail_alt": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "env": {
        "GMAIL_OAUTH_PATH": "${HOME}/.gmail-mcp/gcp-oauth.keys.json",
        "GMAIL_CREDENTIALS_PATH": "${HOME}/.gmail-mcp/credentials-alt.json"
      }
    },
    "gtasks": {
      "command": "npx",
      "args": ["-y", "@alvincrave/gtasks-mcp@0.2.0"],
      "env": {
        "GTASKS_CREDENTIALS_PATH": "${HOME}/.config/gtasks-mcp/gcp-oauth.keys.json",
        "GTASKS_TOKEN_PATH": "${HOME}/.config/gtasks-mcp/token.json",
        "GOOGLE_CLIENT_ID": "${GTASKS_CLIENT_ID:-}",
        "GOOGLE_CLIENT_SECRET": "${GTASKS_CLIENT_SECRET:-}",
        "GOOGLE_REFRESH_TOKEN": "${GTASKS_REFRESH_TOKEN:-}"
      }
    },
    "gtasks_alt": {
      "command": "npx",
      "args": ["-y", "@alvincrave/gtasks-mcp@0.2.0"],
      "env": {
        "GTASKS_CREDENTIALS_PATH": "${HOME}/.config/gtasks-mcp/gcp-oauth.keys.json",
        "GTASKS_TOKEN_PATH": "${HOME}/.config/gtasks-mcp/token-alt.json"
      }
    },
    "gsheets": {
      "command": "npx",
      "args": ["-y", "mcp-gsheets@latest"],
      "env": {
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID}",
        "GOOGLE_APPLICATION_CREDENTIALS": "${HOME}/.config/agents/gcp-service-account.json"
      }
    }
  }
}
