# Copy to `.env` and fill in what you need. `.env` is gitignored.
#
# Nothing here is required to run the GUI against a local database: copy this
# file unchanged, run `python3 src/jobs_gui.py`, and the schema is created on the
# first request. Each variable below says what stops working without it.
#
# Your *identity* is not here -- name, email addresses, LinkedIn, resume Doc ID,
# spreadsheet ID all live in `config/profile.md`. The skills are Markdown and
# cannot read environment variables, so they read that file, and `src/config.py`
# parses the same front matter. One source of truth instead of two that drift.
#
#     cp config/profile.example.md config/profile.md


# ---------------------------------------------------------------- database

# Leave both blank for local SQLite at `data/jobs.db`. Set them and every entry
# point -- GUI, MCP server, cron scripts, a throwaway `python3 -c` -- writes to
# the cloud database instead. There is no staging tier. `src/jobs_db.py` keys off
# the URL alone, so setting only the token is a silent misconfiguration.
#
# Blank is not the same as absent. `load_dotenv(override=False)` refills a
# variable that is *unset*, so to force local for one command, pass it empty:
#
#     TURSO_DATABASE_URL="" TURSO_AUTH_TOKEN="" python3 ...
#
# Check which one you are on before any write:
#
#     python3 -c "import sys; sys.path.insert(0,'.'); from src import jobs_db; print(jobs_db._use_libsql())"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional override for the local database file. Relative paths resolve from the
# repo root. Used for throwaway copies -- the demo database the README
# screenshots are taken against, for one -- without moving `data/jobs.db` aside.
JOBS_DB=


# ---------------------------------------------------------------- google

# Path to your Google Cloud service-account JSON key.
# Cloud Console -> IAM & Admin -> Service Accounts -> Keys -> Add key (JSON),
# with the Sheets, Docs and Drive APIs enabled on the project. Share your resume
# Doc, the folder tailored copies land in, and (if you use one) the tracker sheet
# with the key's `client_email`, or every call 404s with a misleading
# "not found".
#
# Without it: resume-review and job-tracker cannot read or copy the resume Doc,
# and the Sheets-era scripts cannot authenticate.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Cloud project that owns the service account above, read by the `gsheets`
# MCP server in `.mcp.json`.
#
# Note that `.mcp.json` expands the *shell* environment -- `.env` is not sourced
# for MCP server startup. Set it here for the scripts, and also under `"env"` in
# `.claude/settings.local.json` (gitignored) so an interactive Claude Code
# session gets it.
GOOGLE_PROJECT_ID=


# ---------------------------------------------------------------- overrides

# Everything below defaults from `config/profile.md`. Env wins, so a scheduled
# run can be pointed somewhere else without editing a tracked file.
#
# AGENTS_PROFILE=            # alternate path to profile.md
# AGENTS_SPREADSHEET_ID=     # legacy name JOB_TRACKER_SPREADSHEET also works
# AGENTS_NOTIFY_EMAIL=
# AGENTS_OUTREACH_EMAIL=
# AGENTS_OWNER_EMAILS=       # comma-separated
# AGENTS_RESUME_DOC_ID=
# AGENTS_RESUME_FOLDER_ID=
# WS5_RECORD_START=          # YYYY-MM-DD


# ---------------------------------------------------------------- google tasks

# Credentials for the `gtasks` MCP server, used only by inbox-triage to file the
# handful of things that need a human. Needed for headless and cloud runs;
# interactive runs use the OAuth token cached at
# ~/.config/gtasks-mcp/token.json instead.
GTASKS_CLIENT_ID=
GTASKS_CLIENT_SECRET=
GTASKS_REFRESH_TOKEN=
